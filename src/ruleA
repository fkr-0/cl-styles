(defclass style-rule ()
  ((selector :initform nil
     :initarg :selector
     :accessor rule-selector
     :documentation "The selector of the rule.")
    (styles
      :initarg :styles
      :initform (make-style-set)
      :accessor rule-styles
      :documentation "The styles of the rule as list.")
    (matched-objects :accessor matched-objects
      :initform nil
      :initarg :matched-objects))
  (:documentation "A style rule is a selector and a set of styles. Technically
is a list of styles, also to inform the order of the styles. On application however
same properties will override each other."))

(defmethod selecting-style-set ((set style-set) (selector selector))
  "Return the styles of the given style set as a plist."
  (make-instance 'style-rule :selector selector :styles set))

(defmethod print-object ((rule style-rule) stream)
  ;; (print-unreadable-object (rule stream :type t)
  (format stream "<Rule|~a:~a>" (rule-selector rule) (rule-styles rule)));)

(defgeneric style-rule-valid (style-rule)
  (:documentation "Return t if the given style rule is valid, nil otherwise.")
  (:method ((s style-rule))
    (declare (type style-rule s))
    (let ((selector (rule-selector s)) (styles (rule-styles s)))
      (and selector (< 0 (length (hash-table-keys styles)))))))

(defmethod new ((class (eql 'style-rule)) &key (selector nil) (styles nil))
  "Create a new style rule."
  (declare (type selector selector) (type list styles))
  (let ((rule (make-instance 'style-rule :selector selector :styles styles)))
    (when (style-rule-valid rule)
      rule)))

;; hmm
(defmacro defrule (selector &body styles)
  "Create a new style rule. Simple wrapper around
make-instance.
Arguments:
  selector: The selector of the rule as instance of a
selector sub-class.
  styles: The styles of the rule as a list of
style-class instances
Example:
  (defrule (cls> :button) (:bg-color :red))
=> rule that matches all objects of class button and sets
the background color to red."
  `(make-instance 'style-rule :selector ,selector :styles
     (new 'style-set :styles `(,@(quote (,@styles))))))

