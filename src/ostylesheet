(defmethod spec-style! ((s style-group) (spec-table hash-table) (spec integer))
  "Set the specificity of a rule."
  (mapcar (lambda (s) (spec-style! s spec-table spec)) (style-sub-styles s)))


(defmethod key-with-highest-value ((table hash-table))
  "Return the key with the highest value in a hash table."
  (let ((max-key nil)
         (max-value 0))
    (maphash (lambda (key value)
               (when (> value max-value)
                 (setf max-key key)
                 (setf max-value value)))
      table)
    max-key))

(defmethod query-style-sheet ((sheet stylesheet) target)
  "Query a stylesheet for the styles that apply to a target.
Return a style set containing the styles that apply to the target.
The styles are truncated to the ones that apply to the target by
maximizing specificity."
  (let ((styles (copy (styles target)))
         (specced-styles (make-hash-table :test #'eql)))
    (log-info "query-style-sheet" target)
    (maphash (lambda (key value)
               (declare (ignore key))
               (spec-style! value specced-styles 1))
      (style-set-styles styles))
    (dolist (rule (stylesheet-rules sheet))
      (when (selects (rule-selector rule) target)
        (spec-rule! rule specced-styles (selection-specificity (rule-selector rule)))))
                                        ;(calculate-specificity (rule-selector rule)))))
    (dolist (k (hash-table-keys specced-styles))
      (let ((v (key-with-highest-value (gethash k specced-styles))))
        (setf (style-of styles k) v)))
    styles))

(defmethod =? ((s1 style-set) (s2 style-set))
  "Compare two style sets for equality."
  (let ((styles1 (ut.styles.style-set:styles-list s1))
         (styles2 (ut.styles.style-set:styles-list s2)))
    (if (not (= (length styles1) (length styles2)))
      nil
      ;; loop over plist
      (loop for i from 0 to (1- (length styles1))
        do (if (not (equal (nth i styles1) (nth i styles2)))
             (return nil))))
    t))

