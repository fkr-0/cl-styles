;; specificity
;;;;;

(defmethod spec-style! ((s style) (spec-table hash-table) (spec integer))
  "Set the specificity of a rule."
  (let ((m (gethash (tuple-prop s) spec-table (make-hash-table :test #'eql))))
    (log-info "spec-style!" s spec m)
    (setf (gethash (tuple-value s) m)
      (+ (gethash (tuple-value s) m 0) spec) )
    (setf (gethash (tuple-prop s) spec-table) m)))

(defmethod spec-rule! ((r style-rule) (spec-table hash-table) (spec integer))
  "Set the specificity of a rule."
  ;; (dolist (s (stylesheet-rules (rule-styles r)))
  ;;   (spec-style! s spec-table spec))
  (maphash (lambda (key value)
             (declare (ignore key))
             (spec-style! value spec-table spec))
    (style-set-styles (rule-styles r))))

