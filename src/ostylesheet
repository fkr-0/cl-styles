(defclass stylesheet ()
  ((name :initarg :name :accessor stylesheet-name)
    (rules :initarg :rules :accessor stylesheet-rules))
  (:documentation "A set of style rules and means to apply them to/manipulate objects."))

(defmethod merge-rule! ((sheet stylesheet) (rule style-rule) )
  "Add a style rule to a stylesheet."

  (let ((sel (rule-selector rule))
         (ss (rule-styles rule)))
    (dolist (obj (stylesheet-rules sheet))
      (when (=? sel (rule-selector obj))
        (merge-styles! (rule-styles obj) ss)
        (log-info "merged successfully -rule!" (rule-styles obj) ss)
        (return-from merge-rule! nil)))
    (setf (stylesheet-rules sheet) (cons rule (stylesheet-rules sheet))))
  ;; Update the matched objects for the rule.
  ;; (update-matched-objects rule obj-list)
  )


